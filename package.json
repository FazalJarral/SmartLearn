{
  "name": "smartlearn",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev_test": "node scripts/dev-test.mjs",
    "dev_test:check": "node scripts/dev-test.mjs --check",
    "dev_test:worker": "node scripts/dev-test.mjs --worker",
    "dev:web": "npm --workspace apps/web run dev",
    "build:web": "npm --workspace apps/web run build",
    "lint:web": "npm --workspace apps/web run lint",
    "test:web": "npm --workspace apps/web run test",
    "test:api": "python -m pytest apps/api/tests",
    "test:worker": "python -m pytest apps/worker/tests",
    "test": "npm run test:web && npm run test:api && npm run test:worker"
  },
  "engines": {
    "node": ">=22"
  }
}
